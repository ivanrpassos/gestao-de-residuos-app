{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Destinacao",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Identificador único da destinação"
    },
    "tipoMaterial": {
      "type": "string",
      "maxLength": 50,
      "description": "Tipo de material destinado para reciclagem ou descarte"
    },
    "localDestino": {
      "type": "string",
      "maxLength": 100,
      "description": "Local de destino para o material"
    },
    "dataRegistro": {
      "type": ["integer", "string", "null"],
      "description": "Data de registro da destinação"
    },
    "quantidadeKg": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Quantidade de material destinado em kg"
    }
  },
  "required": ["id", "tipoMaterial", "localDestino"],
  "additionalProperties": true
}
